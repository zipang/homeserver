#!/usr/bin/env bash
set -e
BRANCH=${1:-master}
echo "🚀 Starting SKYLAB System Update (Branch: $BRANCH)..."

cd /home/master/homeserver
# Ensure current user owns the directory to avoid git permission errors
sudo chown -R $USER:wheel .

echo "📥 [1/5] Pulling latest changes from Git..."
git fetch origin
git checkout "$BRANCH"
git pull origin "$BRANCH"

echo "🔄 [2/5] Updating Flake lockfile..."
nix flake update

# Commit the lockfile *before* rebuilding: Nix evaluates the git working
# tree, so an uncommitted flake.lock makes it warn "Git tree is dirty" and
# the built configuration would not match the repository state.
LOCK_COMMIT=0
if ! git diff --quiet flake.lock; then
  git add flake.lock
  git commit -m "chore: update flake.lock after system upgrade"
  LOCK_COMMIT=1
else
  echo "✅ No changes to flake.lock. System is up to date."
fi

echo "⚒️  [3/5] Rebuilding NixOS system..."
sudo nixos-rebuild switch --impure --flake .#SKYLAB

if [ "$LOCK_COMMIT" -eq 1 ]; then
  echo "📤 [4/5] Pushing updated flake.lock to repository..."
  git push origin "$BRANCH"
else
  echo "✅ [4/5] Nothing to push."
fi

echo "✨ [5/5] Update complete!"
