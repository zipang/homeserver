#!/usr/bin/env bash
set -euo pipefail
BRANCH=${1:-master}
REPO=/home/master/homeserver
echo "🚀 Starting SKYLAB System Update (Branch: $BRANCH)..."

cd "$REPO"
# Ensure current user owns the directory to avoid git permission errors
sudo chown -R "$USER":wheel .

echo "📥 [1/5] Syncing with origin/$BRANCH (fetch + rebase)..."
git fetch origin
git checkout "$BRANCH"

# Rebase local work onto the remote branch first. `--autostash` keeps any
# uncommitted edits out of the way, so a dirty working tree can never block
# the update.
git rebase --autostash "origin/$BRANCH"

# Publish commits that were made on this host and never pushed. Doing this
# *before* anything else means the next fetch/rebase starts from a clean,
# in-sync branch instead of accumulating stale local commits that later make
# `git pull` or `git push` fail.
AHEAD=$(git rev-list --count "origin/$BRANCH..HEAD")
if [ "$AHEAD" -gt 0 ]; then
  echo "📤 Pushing $AHEAD local commit(s) not yet on origin/$BRANCH..."
  git push origin "$BRANCH"
else
  echo "✅ Local branch is in sync with origin/$BRANCH."
fi

echo "🔄 [2/5] Updating Flake lockfile..."
nix flake update

# Commit the lockfile *before* rebuilding: Nix evaluates the git working
# tree, so an uncommitted flake.lock makes it warn "Git tree is dirty" and
# the built configuration would not match the repository state.
LOCK_COMMIT=0
if ! git diff --quiet flake.lock; then
  git add flake.lock
  git commit -m "chore: update flake.lock after system upgrade"
  LOCK_COMMIT=1
else
  echo "✅ No changes to flake.lock. System is up to date."
fi

echo "⚒️  [3/5] Rebuilding NixOS system..."
# Use `path:.` instead of `.:` so that the untracked (gitignored)
# hosts/SKYLAB/secrets.nix is copied into the Nix store. A plain `.` flake
# reference only includes git-tracked files, which makes the build fail with
# "Mandatory file 'secrets.nix' not found".
sudo nixos-rebuild switch --impure --flake path:.#SKYLAB

if [ "$LOCK_COMMIT" -eq 1 ]; then
  echo "📤 [4/5] Pushing updated flake.lock to repository..."
  git push origin "$BRANCH"
else
  echo "✅ [4/5] Nothing to push."
fi

echo "✨ [5/5] Update complete!"
