#!/usr/bin/env bash
set -euo pipefail

# llama-register — declare a GGUF file already present in the model library.
#
# Usage:
#   llama-register <file> [--id ID] [--name NAME] [--ctx N]
#                         [--mmproj FILE | --no-mmproj] [--force] [--dry-run]
#
# Example:
#   llama-register Qwen3.5-4B-3D-Coder-Q4_K_M.gguf --ctx 8192
#
# It writes one YAML fragment into the llama-swap config directory
# (/share/Skylab/LLMS/llama-swap.d by default), which llama-swap watches and
# merges. Files created this way are never modified by `llama-scan`.
#
# The heavy lifting lives in llama-scan (subcommand `register`).

here="$(dirname "$(readlink -f "$0")")"
exec "$here/llama-scan" register "$@"
