{ config, pkgs, ... }:

let
  domain = config.server.privateDomain;
  certDir = "/var/lib/secrets/certs";
in
{
  # ---------------------------------------------------------------------------
  # Internal TLS certificate for *.${domain}
  #
  # Let's Encrypt cannot issue certificates for a private TLD, so SKYLAB runs
  # its own small CA instead of relying on a wildcard generated by hand with
  # mkcert (which expired after ~2 years with nothing renewing it):
  #
  #   * skylab-ca.{crt,key}  root CA, 10 years, created once, never rotated
  #                          automatically (rotation breaks every client's
  #                          trust store, so it stays a manual decision);
  #   * skylab.{crt,key}     wildcard leaf for *.${domain}, ${domain},
  #                          127.0.0.1 and ::1, valid 825 days.
  #
  # Both live in /var/lib/secrets/certs (outside the Nix store and outside git).
  # The virtual hosts in the service modules keep pointing at these paths.
  #
  # scripts/local-certs does the work idempotently; this module only schedules
  # it:
  #   * before nginx on boot, so the certificate always exists when nginx
  #     starts (and the pending issuance happens on the rebuild that activates
  #     this module);
  #   * daily via the timer, which is what makes renewal automatic — the script
  #     re-issues only when fewer than 30 days remain, then reloads nginx.
  # ---------------------------------------------------------------------------
  systemd.services.skylab-local-certs = {
    description = "Issue or renew the ${domain} wildcard certificate";
    # multi-user.target: run during `nixos-rebuild switch` (and on boot) so the
    # pending issuance happens at deploy time, without waiting for a reboot.
    # nginx.service: guarantees ordering when nginx (re)starts.
    wantedBy = [
      "multi-user.target"
      "nginx.service"
    ];
    before = [ "nginx.service" ];
    path = with pkgs; [
      bash
      coreutils
      openssl
      systemd # systemctl, to reload nginx after a renewal
    ];
    serviceConfig = {
      Type = "oneshot";
      UMask = "0077";
    };
    script = "exec ${../../scripts/local-certs} ${domain}";
  };

  systemd.timers.skylab-local-certs = {
    description = "Daily expiry check for the ${domain} wildcard certificate";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnCalendar = "daily";
      Persistent = true;
      RandomizedDelaySec = "1h";
    };
  };

  # Stable, readable path to export the root CA to client devices, e.g.
  #   scp zipang@skylab:/etc/ssl/certs/skylab-local-ca.crt .
  # (a runtime file, so it cannot be declared with environment.etc).
  systemd.tmpfiles.rules = [
    "L+ /etc/ssl/certs/skylab-local-ca.crt - - - - ${certDir}/skylab-ca.crt"
  ];
}
